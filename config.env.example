# proxyguard configuration — copy to config.env and edit.
# All values are optional; defaults are shown.

# Clash Verge mixed port (HTTP+SOCKS). System proxy is expected to point here.
PROXY_HOST=127.0.0.1
PROXY_PORT=7897
PROXY_PORTS="7897 7898 7899"

# Connectivity probes performed THROUGH the proxy. Any 2xx-4xx (except 407)
# counts as reachable; two URLs plus one retry smooth over node switching.
HEALTH_URLS="http://www.gstatic.com/generate_204 https://api.anthropic.com/"
HEALTH_TIMEOUT=5

# Enforcement cadence (launchd StartInterval must match; plist uses 10).
INTERVAL=10

# Consecutive failed ticks before killing. 2 ticks @10s ≈ 20s.
FAIL_THRESHOLD=2

# Grace period measured from the guard's first tick after this boot (state is
# kept per boot). Inside it, health failures only log; a live direct bypass
# still kills immediately. Covers login where Clash Verge may start a few
# seconds after launchd.
STARTUP_GRACE=30

# 1 = actually kill; 0 = log only (safe observation mode).
ENFORCE=1

# Accept mihomo TUN (utun1024, 198.18.0.1/30) as full IPv4 coverage.
# Coverage is verified by route lookups to four points across the unicast
# address space; if any probe leaves via another interface, the TUN is not
# treated as coverage. This matches Clash's 1.0.0.0/8..128.0.0.0/1 route set.
ALLOW_TUN=1

# Inspect live mihomo connections. A connection to a Claude/Anthropic/OpenAI
# host whose rule chain starts with DIRECT is "not proxied" even when TUN
# carries the packets, and is treated as a bypass.
VERIFY_CHAINS=1
CLAUDE_HOST_RE='(^|[.])(anthropic[.]com|claude[.]ai|claudeusercontent[.]com|openai[.]com|chatgpt[.]com)$'
CHAIN_DIRECT_KILL=1

# 1 = if the rule-chain audit cannot run while Claude processes are alive
# (controller unreadable, jq missing, process attribution unavailable), the
# exit is unverified and the tick counts as unhealthy. TUN alone cannot prove
# the selected group. 0 = fall back to trusting verified TUN coverage.
REQUIRE_CHAIN_AUDIT=1

# 0 = only report DIRECT connections to hosts outside CLAUDE_HOST_RE (magpie's
# other upstreams). 1 = treat them as a bypass too. Model hosts are governed by
# CLAUDE_HOST_RE + REQUIRED_CHAIN either way.
KILL_ANY_DIRECT=0

# The only acceptable final exit. Every active Claude/Anthropic/OpenAI
# connection must have this exact mihomo group in its chain; a connection
# through another node/group (or DIRECT) counts as not proxied. Name must
# match the group name as mihomo reports it, emoji included. Set to "" to
# accept any non-DIRECT chain.
REQUIRED_CHAIN="🛡️ 静态IP出口"

# Include /Applications/magpie.app (the local model gateway) in the kill set.
# Claude Desktop and Claude Code send model traffic to 127.0.0.1:3425 (magpie),
# and magpie is what actually dials out. Set 0 if you do not want it touched.
KILL_GATEWAY=1

# A non-loopback socket with no TUN coverage is a bypass: kill immediately
# instead of waiting for FAIL_THRESHOLD.
BYPASS_KILL_IMMEDIATE=1

# Under TUN, a live control plane plus verified route coverage counts as
# proxied; an upstream node blocking the probe URL is not a direct-egress leak.
# Set 1 to keep requiring the TCP/HTTP probe even when TUN covers.
HEALTH_UNDER_TUN=0

# Grace after a detected sleep/wake gap (seconds).
WAKE_GRACE=15

# Egress-IP profile (geo.sh). Every GEO_REFRESH seconds the guard looks up the
# current egress IP and derives timezone/region/coordinates; the result drives
# the TZ injected into the Claude chain and the "IP 身份" card in the app.
GEO_ENABLED=1
GEO_REFRESH=600
# Free-text address. Device location (CoreLocation / Wi-Fi / GPS) is NEVER
# read; when set, this address is the only location shown in place of the IP
# city. Time still follows the IP timezone.
GEO_ADDRESS=""
# 1 = write TZ into Claude Code's settings env and force the telemetry
# switches (DISABLE_TELEMETRY, DISABLE_ERROR_REPORTING, DO_NOT_TRACK,
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC) to "1". A one-time backup is kept
# at ~/.claude/settings.json.proxyguard.bak.
GEO_WRITE_CC_ENV=1

# 0 = only kill processes (default). 1 = also power off Wi-Fi (machine-wide,
# affects every app and this session; opt in deliberately).
CUT_NETWORK=0
WIFI_DEVICE=en0

STATE_DIR="$HOME/.cache/proxyguard"
LOG_FILE="$HOME/Library/Logs/proxyguard.log"
LOG_MAX_BYTES=1048576

# Advanced: force a specific mihomo controller socket path. Empty = auto
# (per-user Clash Verge path, then the running mihomo process's -ext-ctl-unix).
MIHOMO_SOCK_OVERRIDE=""

# 1 = never kill, only log the intent (handy while evaluating the guard).
DRY_RUN=0

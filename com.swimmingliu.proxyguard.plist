<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swimmingliu.proxyguard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__GUARD__</string>
    <string>--once</string>
  </array>
  <key>StartInterval</key>
  <integer>10</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>5</integer>
  <!-- guard.sh starts the geo lookup detached so it never delays a verdict;
       without this, launchd kills that child when the tick exits. -->
  <key>AbandonProcessGroup</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOGOUT__</string>
  <key>StandardErrorPath</key>
  <string>__LOGERR__</string>
</dict>
</plist>
